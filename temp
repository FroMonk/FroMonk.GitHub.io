/* ── Dark (Catppuccin Mocha) ── */
:root,
[data-theme="dark"] {
  --background: #1e1e2e;
  --foreground: #cdd6f4;
  --card: #181825;
  --card-foreground: #cdd6f4;
  --popover: #181825;
  --popover-foreground: #cdd6f4;
  --primary: #cba6f7;
  --primary-foreground: #1e1e2e;
  --secondary: #45475a;
  --secondary-foreground: #cdd6f4;
  --muted: #181825;
  --muted-foreground: #a6adc8;
  --accent: #585b70;
  --accent-foreground: #cdd6f4;
  --destructive: #f38ba8;
  --destructive-foreground: #1e1e2e;
  --border: #313244;
  --input: #313244;
  --ring: #cba6f7;

  --sidebar: #181825;
  --sidebar-foreground: #cdd6f4;
  --sidebar-border: #313244;
  --sidebar-accent: #313244;
  --sidebar-accent-foreground: #cdd6f4;

  --scrollbar-track: #181825;
  --scrollbar-border: #313244;

  --dialogue-color: #cba6f7;
  --blockquote-color: #a6adc8;
  --blockquote-border: #89b4fa;
  --code-bg: #181825;
  --code-fg: #a6e3a1;
  --code-border: #313244;
}

/* ── Light (Catppuccin Frappe) ── */
[data-theme="light"] {
  --background: #303446;
  --foreground: #c6d0f5;
  --card: #292c3c;
  --card-foreground: #c6d0f5;
  --popover: #292c3c;
  --popover-foreground: #c6d0f5;
  --primary: #ca9ee6;
  --primary-foreground: #303446;
  --secondary: #51576d;
  --secondary-foreground: #c6d0f5;
  --muted: #292c3c;
  --muted-foreground: #a5adce;
  --accent: #626880;
  --accent-foreground: #c6d0f5;
  --destructive: #e78284;
  --destructive-foreground: #303446;
  --border: #414559;
  --input: #414559;
  --ring: #ca9ee6;

  --sidebar: #292c3c;
  --sidebar-foreground: #c6d0f5;
  --sidebar-border: #414559;
  --sidebar-accent: #414559;
  --sidebar-accent-foreground: #c6d0f5;

  --scrollbar-track: #292c3c;
  --scrollbar-border: #414559;

  --dialogue-color: #ca9ee6;
  --blockquote-color: #a5adce;
  --blockquote-border: #8caaee;
  --code-bg: #292c3c;
  --code-fg: #a6d189;
  --code-border: #414559;
}

/* ── Markdown ── */

.mari-md-blockquote {
  border-left-color: var(--blockquote-border);
  color: var(--blockquote-color);
}

.mari-md-inline-code {
  background: var(--code-bg);
  color: var(--code-fg);
  border-color: var(--code-border);
}

.mari-md-codeblock {
  background: var(--code-bg);
  color: var(--code-fg);
  border-color: var(--code-border);
}

.mari-message-content strong {
  color: var(--dialogue-color);
}

/* ── Scrollbars ── */

::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--scrollbar-track); }
::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: var(--popover); }
