/* ── Dark (Catppuccin Frappe) ── */
:root,
[data-theme="dark"] {
  --background: #303446;
  --foreground: #c6d0f5;
  --card: #292c3c;
  --card-foreground: #c6d0f5;
  --popover: #292c3c;
  --popover-foreground: #c6d0f5;
  --primary: #ca9ee6;
  --primary-foreground: #303446;
  --secondary: #51576d;
  --secondary-foreground: #c6d0f5;
  --muted: #292c3c;
  --muted-foreground: #a5adce;
  --accent: #626880;
  --accent-foreground: #c6d0f5;
  --destructive: #e78284;
  --destructive-foreground: #303446;
  --border: #414559;
  --input: #414559;
  --ring: #ca9ee6;

  --sidebar: #292c3c;
  --sidebar-foreground: #c6d0f5;
  --sidebar-border: #414559;
  --sidebar-accent: #414559;
  --sidebar-accent-foreground: #c6d0f5;

  --scrollbar-track: #292c3c;
  --scrollbar-border: #414559;

  --dialogue-color: #ca9ee6;
  --blockquote-color: #a5adce;
  --blockquote-border: #8caaee;
  --code-bg: #292c3c;
  --code-fg: #a6d189;
  --code-border: #414559;
}

/* ── Light (Catppuccin Latte) ── */
[data-theme="light"] {
  --background: #eff1f5;
  --foreground: #4c4f69;
  --card: #e6e9ef;
  --card-foreground: #4c4f69;
  --popover: #dce0e8;
  --popover-foreground: #4c4f69;
  --primary: #8839ef;
  --primary-foreground: #eff1f5;
  --secondary: #ccd0da;
  --secondary-foreground: #4c4f69;
  --muted: #dce0e8;
  --muted-foreground: #6c6f85;
  --accent: #bcc0cc;
  --accent-foreground: #4c4f69;
  --destructive: #d20f39;
  --destructive-foreground: #eff1f5;
  --border: #ccd0da;
  --input: #ccd0da;
  --ring: #8839ef;

  --sidebar: #e6e9ef;
  --sidebar-foreground: #4c4f69;
  --sidebar-border: #ccd0da;
  --sidebar-accent: #ccd0da;
  --sidebar-accent-foreground: #4c4f69;

  --scrollbar-track: #e6e9ef;
  --scrollbar-border: #ccd0da;

  --dialogue-color: #8839ef;
  --blockquote-color: #6c6f85;
  --blockquote-border: #1e66f5;
  --code-bg: #dce0e8;
  --code-fg: #40a02b;
  --code-border: #ccd0da;
}

/* ── Markdown ── */

.mari-md-blockquote {
  border-left-color: var(--blockquote-border);
  color: var(--blockquote-color);
}

.mari-md-inline-code {
  background: var(--code-bg);
  color: var(--code-fg);
  border-color: var(--code-border);
}

.mari-md-codeblock {
  background: var(--code-bg);
  color: var(--code-fg);
  border-color: var(--code-border);
}

.mari-message-content strong {
  color: var(--dialogue-color);
}

/* ── Scrollbars ── */

::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--scrollbar-track); }
::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: var(--popover); }
